# Database
DATABASE_URL=postgresql://skillverse:skillverse_dev@localhost:5432/skillverse
DATABASE_ECHO=false

# Auth — JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Auth — OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Redis (for future use — rate limiting, caching)
REDIS_URL=redis://localhost:6379/0

# Email (Phase 2: console backend for development)
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@skillverse.dev

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
ENVIRONMENT=development
LOG_LEVEL=info
